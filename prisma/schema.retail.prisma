// ============================================================================
// UNIVERSAL RETAIL POS - PRISMA POSTGRESQL SCHEMA
// Complete relational schema for production deployment & local PostgreSQL
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RetailUserRole {
  ADMIN
  MANAGER
  CASHIER
  STOCK
}

enum RetailProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RetailMovementType {
  SALE
  PURCHASE
  RETURN
  ADJUSTMENT
  DAMAGE
  MANUAL
}

enum RetailOrderType {
  WALK_IN
  DELIVERY
  PICKUP
}

enum RetailOrderStatus {
  COMPLETED
  HOLD
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum RetailPaymentMethod {
  CASH
  CARD
  SPLIT
  BANK_TRANSFER
  DIGITAL
}

enum RetailShiftStatus {
  OPEN
  CLOSED
}

model RetailShop {
  id              String   @id @default(uuid())
  name            String
  nameAr          String
  tagline         String?
  address         String?
  phone           String?
  email           String?
  trn             String?  // UAE TRN (15-digit)
  logoUrl         String?
  defaultCurrency String   @default("AED")
  vatPercentage   Float    @default(5.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           RetailUser[]
  products        RetailProduct[]
  categories      RetailCategory[]
  orders          RetailOrder[]
  purchases       RetailPurchase[]
  shifts          RetailCashierShift[]
}

model RetailUser {
  id           String         @id @default(uuid())
  shopId       String
  shop         RetailShop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  email        String         @unique
  passwordHash String
  role         RetailUserRole @default(CASHIER)
  pin          String?
  active       Boolean        @default(true)
  phone        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  orders       RetailOrder[]
  shifts       RetailCashierShift[]
  auditLogs    RetailAuditLog[]
}

model RetailCategory {
  id        String          @id @default(uuid())
  shopId    String
  shop      RetailShop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  nameAr    String
  slug      String
  order     Int             @default(0)
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  products  RetailProduct[]

  @@unique([shopId, slug])
}

model RetailBrand {
  id        String   @id @default(uuid())
  name      String   @unique
  nameAr    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RetailUnit {
  id         String   @id @default(uuid())
  name       String   @unique
  nameAr     String
  shortCode  String
  createdAt  DateTime @default(now())
}

model RetailProduct {
  id                 String              @id @default(uuid())
  shopId             String
  shop               RetailShop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name               String
  nameAr             String
  sku                String
  barcode            String
  categoryId         String
  category           RetailCategory      @relation(fields: [categoryId], references: [id])
  brandName          String?
  unit               String              @default("Piece")
  costPrice          Float               @default(0.0)
  sellingPrice       Float               @default(0.0)
  discountPercentage Float?              @default(0.0)
  taxPercentage      Float               @default(5.0)
  stock              Int                 @default(0)
  minStockAlert      Int                 @default(5)
  image              String?
  description        String?
  status             RetailProductStatus @default(ACTIVE)
  expiryDate         DateTime?
  batchNumber        String?
  isPinned           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  variants           RetailProductVariant[]
  movements          RetailStockMovement[]
  priceHistories     RetailPriceHistory[]
  orderItems         RetailOrderItem[]

  @@unique([shopId, sku])
  @@unique([shopId, barcode])
  @@index([shopId, categoryId])
}

model RetailProductVariant {
  id            String        @id @default(uuid())
  productId     String
  product       RetailProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String        @unique
  barcode       String        @unique
  priceModifier Float         @default(0.0)
  stock         Int           @default(0)
  variantType   String
  variantValue  String
}

model RetailStockMovement {
  id            String             @id @default(uuid())
  productId     String
  product       RetailProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          RetailMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  referenceId   String?
  userId        String
  userName      String
  reason        String?
  createdAt     DateTime           @default(now())

  @@index([productId, createdAt])
}

model RetailPriceHistory {
  id            String        @id @default(uuid())
  productId     String
  product       RetailProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceType     String        // COST or SELLING
  oldPrice      Float
  newPrice      Float
  currency      String        @default("AED")
  changedById   String
  changedByName String
  reason        String?
  createdAt     DateTime      @default(now())
}

model RetailCustomer {
  id               String        @id @default(uuid())
  name             String
  phone            String        @unique
  email            String?
  address          String?
  notes            String?
  totalOrders      Int           @default(0)
  totalSpent       Float         @default(0.0)
  lastPurchaseDate DateTime?
  createdAt        DateTime      @default(now())

  orders           RetailOrder[]
}

model RetailSupplier {
  id             String           @id @default(uuid())
  name           String
  companyName    String
  phone          String
  email          String?
  address        String?
  totalPurchases Int              @default(0)
  totalSpent     Float            @default(0.0)
  createdAt      DateTime         @default(now())

  purchases      RetailPurchase[]
}

model RetailOrder {
  id                     String              @id @default(uuid())
  shopId                 String
  shop                   RetailShop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderNumber            String              @unique
  orderType              RetailOrderType     @default(WALK_IN)
  status                 RetailOrderStatus   @default(COMPLETED)
  customerId             String?
  customer               RetailCustomer?     @relation(fields: [customerId], references: [id])
  customerName           String?
  customerPhone          String?
  deliveryAddress        String?
  cashierId              String
  cashier                RetailUser          @relation(fields: [cashierId], references: [id])
  shiftId                String?
  shift                  RetailCashierShift? @relation(fields: [shiftId], references: [id])
  itemCount              Int
  subtotal               Float
  discountType           String              @default("NONE")
  discountValue          Float               @default(0.0)
  discountTotal          Float               @default(0.0)
  taxPercentage          Float               @default(5.0)
  taxableAmount          Float
  taxTotal               Float
  grandTotal             Float
  paidTotal              Float
  changeTotal            Float
  notes                  String?
  completedAt            DateTime            @default(now())
  createdAt              DateTime            @default(now())

  items                  RetailOrderItem[]
  payments               RetailPayment[]
  currencySnapshot       RetailCurrencySnapshot?
  returns                RetailSaleReturn[]

  @@index([shopId, createdAt])
}

model RetailOrderItem {
  id             String        @id @default(uuid())
  orderId        String
  order          RetailOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        RetailProduct @relation(fields: [productId], references: [id])
  productName    String
  sku            String
  barcode        String
  variantName    String?
  unitPrice      Float
  quantity       Int
  costPrice      Float
  discountAmount Float         @default(0.0)
  taxPercentage  Float         @default(5.0)
  taxAmount      Float
  lineTotal      Float
}

model RetailPayment {
  id            String              @id @default(uuid())
  orderId       String
  order         RetailOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        RetailPaymentMethod
  amount        Float
  cashTendered  Float?
  changeGiven   Float?
  cardType      String?
  reference     String?
  createdAt     DateTime            @default(now())
}

model RetailCurrencySnapshot {
  id                String      @id @default(uuid())
  orderId           String      @unique
  order             RetailOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  currencyCode      String
  currencySymbol    String
  currencyDisplay   String
  decimals          Int         @default(2)
  exchangeRateToAED Float       @default(1.0)
  subtotal          Float
  discount          Float
  taxableAmount     Float
  taxAmount         Float
  grandTotal        Float
  paidAmount        Float
  changeAmount      Float
}

model RetailHeldSale {
  id            String   @id @default(uuid())
  holdReference String
  orderType     String
  customerId    String?
  customerName  String?
  itemsJson     String   // Serialized OrderItem[]
  discountType  String
  discountValue Float
  currencyCode  String
  cashierId     String
  cashierName   String
  heldAt        DateTime @default(now())
}

model RetailSaleReturn {
  id                  String      @id @default(uuid())
  returnNumber        String      @unique
  originalOrderId     String
  originalOrder       RetailOrder @relation(fields: [originalOrderId], references: [id])
  totalRefundAmount   Float
  refundMethod        String
  processedById       String
  processedByName     String
  reason              String
  createdAt           DateTime    @default(now())

  items               RetailReturnItem[]
}

model RetailReturnItem {
  id                String           @id @default(uuid())
  returnId          String
  returnOrder       RetailSaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId         String
  productName       String
  returnedQuantity  Int
  unitPrice         Float
  refundAmount      Float
  reason            String
}

model RetailPurchase {
  id             String         @id @default(uuid())
  shopId         String
  shop           RetailShop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchaseNumber String         @unique
  supplierId     String
  supplier       RetailSupplier @relation(fields: [supplierId], references: [id])
  totalAmount    Float
  status         String         @default("RECEIVED")
  receivedById   String
  receivedByName String
  purchaseDate   DateTime       @default(now())
  createdAt      DateTime       @default(now())

  items          RetailPurchaseItem[]
}

model RetailPurchaseItem {
  id          String         @id @default(uuid())
  purchaseId  String
  purchase    RetailPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  sku         String
  quantity    Int
  costPrice   Float
  totalCost   Float
}

model RetailCashierShift {
  id            String            @id @default(uuid())
  shopId        String
  shop          RetailShop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashierId     String
  cashier       RetailUser        @relation(fields: [cashierId], references: [id])
  openedAt      DateTime          @default(now())
  closedAt      DateTime?
  status        RetailShiftStatus @default(OPEN)
  openingCash   Float
  expectedCash  Float?
  actualCash    Float?
  variance      Float?
  cashSales     Float             @default(0.0)
  cardSales     Float             @default(0.0)
  totalSales    Float             @default(0.0)
  cashInTotal   Float             @default(0.0)
  cashOutTotal  Float             @default(0.0)
  refundsTotal  Float             @default(0.0)
  notes         String?

  movements     RetailCashMovement[]
  orders        RetailOrder[]
}

model RetailCashMovement {
  id        String             @id @default(uuid())
  shiftId   String
  shift     RetailCashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      String             // CASH_IN or CASH_OUT
  amount    Float
  reason    String
  userId    String
  userName  String
  createdAt DateTime           @default(now())
}

model RetailAuditLog {
  id          String      @id @default(uuid())
  userId      String
  user        RetailUser  @relation(fields: [userId], references: [id])
  userName    String
  userRole    String
  action      String
  entity      String
  entityId    String?
  details     String
  beforeState String?
  afterState  String?
  createdAt   DateTime    @default(now())
}
